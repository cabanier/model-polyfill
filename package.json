{
  "name": "model-polyfill",
  "version": "0.1.0",
  "private": true,
  "description": "A Three.js WebGPU fallback for the proposed HTML <model> element.",
  "type": "module",
  "main": "./dist/model-polyfill.js",
  "module": "./dist/model-polyfill.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/model-polyfill.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": [
    "./src/index.js",
    "./dist/model-polyfill.js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "three": "^0.185.1",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.19"
  },
  "license": "UNLICENSED"
}
